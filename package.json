{
  "name": "sales-app",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant Sales & Order Management SaaS",
  "workspaces": [
    "packages/shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "test": "npm run test --workspaces --if-present",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "test:shared": "npm run test --workspace=packages/shared",
    "db:push": "npm run db:push --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "lint": "npm run lint --workspaces --if-present"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
